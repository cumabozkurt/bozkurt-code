{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOZKURT CODE",
  "mainBinaryName": "bozkurt-mobile",
  "version": "1.0.1",
  "identifier": "tr.cumabozkurt.bozkurtcode.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "BOZKURT CODE", "width": 420, "height": 860 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: ws: https: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Cuma Bozkurt and contributors",
    "copyright": "Copyright © 2026 Cuma Bozkurt and contributors",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": { "minimumSystemVersion": "14.0" },
    "android": { "minSdkVersion": 24 }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["bozkurt"], "appLink": false }]
    }
  }
}
