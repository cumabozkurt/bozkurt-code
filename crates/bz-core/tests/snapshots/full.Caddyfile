# Generated by BOZKURT CODE - do not edit; changes are overwritten.
# Per-site customisation: caddy/snippets/<domain>.caddy
{
	admin 127.0.0.1:2019
	http_port 80
	https_port 443
	auto_https disable_redirects
	skip_install_trust
	persist_config off
	default_bind 127.0.0.1 [::1]
}

# HTTP -> HTTPS
http://api.test, http://blog.test, http://cms.test, http://grafana.test, http://next.test, http://shop.test, http://*.shop.test, http://admin.shop.test, http://shop-alt.test, http://vite.test {
	redir https://{host}{uri} 308
}

# site api (php, symfony)
(bz-site-api) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-api.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	root * "/home/u/code/api/public"
	@dotfiles {
		path */.*
		not path /.well-known/*
	}
	respond @dotfiles 404
	@php_direct {
		path *.php
		not path /index.php
	}
	respond @php_direct 404
	php_fastcgi 127.0.0.1:9084
	file_server
}
api.test {
	tls "/home/u/.bozkurt/certs/api.test.pem" "/home/u/.bozkurt/certs/api.test-key.pem"
	import bz-site-api
}

# site blog (php, wordpress)
(bz-site-blog) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-blog.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	root * "/home/u/code/blog"
	@dotfiles {
		path */.*
		not path /.well-known/*
	}
	respond @dotfiles 404
	@wp_forbidden path_regexp ^/(wp-config\.php|wp-content/debug\.log|wp-content/uploads/.*\.php|wp-includes/[^/]+\.php)$
	respond @wp_forbidden 403
	php_fastcgi 127.0.0.1:9082
	file_server
}
blog.test {
	tls internal
	import bz-site-blog
}

# site cms (php, drupal)
(bz-site-cms) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-cms.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	root * "/home/u/code/cms/web"
	@dotfiles {
		path */.*
		not path /.well-known/*
	}
	respond @dotfiles 404
	@drupal_private path_regexp (^/sites/[^/]+/files/private/|^/vendor/|\.(engine|inc|install|module|profile|theme|twig|yml)$)
	respond @drupal_private 403
	respond "PHP latest is not installed - run: bz runtime install php latest" 502
	file_server
}
cms.test {
	tls "/home/u/.bozkurt/certs/cms.test.pem" "/home/u/.bozkurt/certs/cms.test-key.pem"
	import bz-site-cms
}

# site docs (static)
(bz-site-docs) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-docs.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	root * "/home/u/code/docs/dist"
	@dotfiles path */.*
	respond @dotfiles 404
	file_server
}
http://docs.test {
	import bz-site-docs
}

# site grafana (proxy)
(bz-site-grafana) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-grafana.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	reverse_proxy localhost:3000
	import "/home/u/.bozkurt/caddy/snippets/grafana.test.caddy"
}
grafana.test {
	tls "/home/u/.bozkurt/certs/grafana.test.pem" "/home/u/.bozkurt/certs/grafana.test-key.pem"
	import bz-site-grafana
}

# site next (app, nextjs)
(bz-site-next) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-next.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	reverse_proxy localhost:41234
}
next.test {
	tls "/home/u/.bozkurt/certs/next.test.pem" "/home/u/.bozkurt/certs/next.test-key.pem"
	import bz-site-next
}

# site shop (php, laravel)
(bz-site-shop) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-shop.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	root * "/home/u/code/shop/public"
	@dotfiles {
		path */.*
		not path /.well-known/*
	}
	respond @dotfiles 404
	php_fastcgi unix//home/u/.bozkurt/services/php-fpm-8.3/fpm.sock {
		env "APP_ENV" "local"
	}
	file_server
}
shop.test, *.shop.test, admin.shop.test {
	tls "/home/u/.bozkurt/certs/shop.test.pem" "/home/u/.bozkurt/certs/shop.test-key.pem"
	import bz-site-shop
}
shop-alt.test {
	tls "/home/u/.bozkurt/certs/shop-alt.test.pem" "/home/u/.bozkurt/certs/shop-alt.test-key.pem"
	import bz-site-shop
}

# site vite (app, vite)
(bz-site-vite) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-vite.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	respond "App is not running - run: bz site start vite" 502
}
vite.test {
	tls "/home/u/.bozkurt/certs/vite.test.pem" "/home/u/.bozkurt/certs/vite.test-key.pem"
	import bz-site-vite
}
