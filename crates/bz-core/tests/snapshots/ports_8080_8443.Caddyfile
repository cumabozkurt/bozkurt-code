# Generated by BOZKURT CODE - do not edit; changes are overwritten.
# Per-site customisation: caddy/snippets/<domain>.caddy
{
	admin 127.0.0.1:2019
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	skip_install_trust
	persist_config off
	default_bind 127.0.0.1 [::1]
}

# HTTP -> HTTPS
http://shop.test, http://*.shop.test, http://admin.shop.test, http://shop-alt.test {
	redir https://{host}:8443{uri} 308
}

# site shop (php, laravel)
(bz-site-shop) {
	encode zstd gzip
	log {
		output file "/home/u/.bozkurt/logs/site-shop.log" {
			roll_size 5MiB
			roll_keep 3
		}
	}
	root * "/home/u/code/shop/public"
	@dotfiles {
		path */.*
		not path /.well-known/*
	}
	respond @dotfiles 404
	php_fastcgi unix//home/u/.bozkurt/services/php-fpm-8.3/fpm.sock {
		env "APP_ENV" "local"
	}
	file_server
}
shop.test, *.shop.test, admin.shop.test {
	tls "/home/u/.bozkurt/certs/shop.test.pem" "/home/u/.bozkurt/certs/shop.test-key.pem"
	import bz-site-shop
}
shop-alt.test {
	tls "/home/u/.bozkurt/certs/shop-alt.test.pem" "/home/u/.bozkurt/certs/shop-alt.test-key.pem"
	import bz-site-shop
}
